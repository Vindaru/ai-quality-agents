# Copy to .env and fill in only if you want to run the evals against a real model.
# With no values set, everything runs offline against the deterministic mock.

# mock (default) | anthropic
AIQ_LLM_PROVIDER=mock
# Model used when AIQ_LLM_PROVIDER=anthropic
AIQ_LLM_MODEL=claude-opus-5-5
# Required only when AIQ_LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
